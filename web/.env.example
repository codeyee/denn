# Server-only URLs used by TanStack Start. The browser talks to same-origin BFF routes.
API_URL=http://127.0.0.1:8000/api
PROXY_API_URL=http://127.0.0.1:8080/v1/proxy

# Shared with core:PROXY_API_KEY and proxy:API_KEY. Never use a public prefix.
PROXY_API_KEY=replace-with-one-shared-local-value
DISABLE_RATE_LIMITS=false

# Local HTTP only. Production must set this to true.
AUTH_COOKIE_SECURE=false
