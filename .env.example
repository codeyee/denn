# =============================================================================
# Django Core
# =============================================================================
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# =============================================================================
# Go Proxy Microservice (required)
# =============================================================================
PROXY_API_BASE_URL=http://localhost:8080/v1/proxy
PROXY_API_KEY=your-proxy-api-key-here

# =============================================================================
# Database
# PostgreSQL via DATABASE_URL (recommended for production).
# Falls back to SQLite if not set.
# =============================================================================
DATABASE_URL=postgresql://user:password@localhost:5432/denn_api

# =============================================================================
# Redis (optional)
# Falls back to in-memory cache if not set.
# The root launcher (`make up`) injects a temporary Redis automatically.
# =============================================================================
REDIS_URL=redis://localhost:6379/1

# =============================================================================
# CORS
# =============================================================================
# Comma-separated list of allowed origins (e.g. your frontend URL).
# localhost on any port is allowed by default in development.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Set to "true" to disable automatic localhost CORS allowance (production)
DISABLE_LOCALHOST_CORS=False

# Set to "true" to disable automatic localhost CSRF trusted origins (production)
DISABLE_LOCALHOST_CSRF=False

# Extra CSRF trusted origins (comma-separated, must include scheme)
CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# =============================================================================
# Railway (set automatically by the platform, do not set manually)
# =============================================================================
# RAILWAY_PUBLIC_DOMAIN=your-app.up.railway.app
# RAILWAY_ENVIRONMENT=production
