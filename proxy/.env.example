# =============================================================================
# Server runtime
# =============================================================================
PORT=8080
CORS_ALLOW_ORIGINS=*
RATE_LIMIT_PER_MINUTE=300

# =============================================================================
# Auth
# =============================================================================
# Shared API key. Same string as `core:PROXY_API_KEY` and `web:PROXY_API_KEY`.
# The proxy refuses to start if this is empty (see internal/config/config.go
# and internal/middleware/auth.go).
API_KEY=

# =============================================================================
# Upstream provider keys (server-only, never exposed elsewhere)
# =============================================================================
TMDB_API_KEY=

IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# =============================================================================
# Cache
# =============================================================================
# Optional outside Compose; local Compose injects redis://redis:6379/1.
# Falls back to a no-op cache if unset (rate limiting also degrades).
REDIS_URL=redis://localhost:6379/1
